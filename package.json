{
  "name": "trip-assistant",
  "productName": "와니의 결재 도우미",
  "version": "0.2.4",
  "description": "아마란스10 출장신청서·출장보고서 자동 작성 (레인보우로보틱스)",
  "main": "src/main.js",
  "author": "Rainbow Robotics 개발 2팀",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "node scripts/brand-dev-electron.js && electron .",
    "postinstall": "node scripts/brand-dev-electron.js",
    "test": "node --test test/rules.test.js",
    "e2e": "electron test/e2e.js",
    "predist": "node scripts/write-builtin-key.js",
    "dist": "electron-builder",
    "dist:win": "node scripts/write-builtin-key.js && electron-builder --win",
    "dist:mac": "node scripts/write-builtin-key.js && electron-builder --mac",
    "dist:linux": "node scripts/write-builtin-key.js && electron-builder --linux",
    "dev": "node scripts/brand-dev-electron.js && electron .",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.rainbowrobotics.tripassistant",
    "productName": "Wani Approval Assistant",
    "artifactName": "trip-assistant-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "와니의 결재 도우미",
      "uninstallDisplayName": "와니의 결재 도우미"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": {
        "teamId": "UZZ8BPHPA2"
      },
      "extendInfo": {
        "CFBundleDisplayName": "Wani Approval Assistant",
        "LSHasLocalizedDisplayName": true
      },
      "extraResources": [
        {
          "from": "build/lproj/InfoPlist.strings",
          "to": "ko.lproj/InfoPlist.strings"
        },
        {
          "from": "build/lproj/InfoPlist.strings",
          "to": "en.lproj/InfoPlist.strings"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "maintainer": "Rainbow Robotics <noreply@rainbow-robotics.com>",
      "executableName": "trip-assistant",
      "synopsis": "아마란스10 출장신청서·보고서 자동 작성",
      "desktop": {
        "Name": "와니의 결재 도우미"
      }
    },
    "forceCodeSigning": false,
    "deb": {
      "afterInstall": "build/linux/after-install.sh",
      "afterRemove": "build/linux/after-remove.sh"
    },
    "rpm": {
      "afterInstall": "build/linux/after-install.sh",
      "afterRemove": "build/linux/after-remove.sh"
    }
  },
  "homepage": "https://www.rainbow-robotics.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/dfd1123/rb-trip-assistant.git"
  }
}
