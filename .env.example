# .env 로 복사해서 채우기
GEMINI_API_KEY=
# 한국수출입은행 환율 Open API 인증키 (해외출장 환율, 앱에 내장)
OPEN_API_KEY=
# 네이버 지역 검색 (NAVER API HUB, 네이버 클라우드 플랫폼) — 출장지 자동완성·좌표 길찾기
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 실패·막힘 기록을 받을 슬랙 (봇 토큰 xoxb-… · 채널 ID C…). 봇 권한: chat:write, files:write — 채널에 봇을 초대해 두세요
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
